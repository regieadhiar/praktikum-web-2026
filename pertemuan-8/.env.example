# File: pertemuan-8/.env.example
# Salin berkas ini menjadi .env lalu sesuaikan nilainya dengan lingkungan Anda.

# String koneksi MySQL: mysql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/NAMA_DATABASE"

# Nama aplikasi yang tampil pada halaman beranda
APP_NAME="Portal Praktikum Web Next.js"

# Kunci rahasia sesi (ganti dengan nilai acak yang panjang)
SESSION_SECRET="ganti-dengan-kunci-rahasia-acak"
